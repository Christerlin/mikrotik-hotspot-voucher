# ---- Serveur ----
PORT=3000

# ---- Base de données (Render/Railway fournissent DATABASE_URL) ----
DATABASE_URL=postgres://user:pass@host:5432/dbname
# Recommandé en prod : coller le PEM du CA fourni par l'hébergeur (ou un chemin)
# DATABASE_CA_CERT=
# Dernier recours seulement :
# DATABASE_SSL_INSECURE=false

# ---- Pay'm (agrégateur MonCash / NatCash / Kashpaw) ----
PAYM_BASE_URL=https://plopplop.solutionip.app
PAYM_CLIENT_ID=pp_xxxxxxxxxxxxxxxx
# Nécessaire uniquement pour les payouts (non requis pour vendre des vouchers) :
# PAYM_CLIENT_SECRET=

# ---- Routeur (modèle "pull" pour Starlink/CGNAT) ----
# Jeton partagé : le script RouterOS l'envoie pour appeler /api/router/*.
# Générez une valeur longue et aléatoire, ex : openssl rand -hex 24
ROUTER_PULL_TOKEN=remplacez-par-un-jeton-long-et-aleatoire

# ---- Sécurité / réseau ----
# Origines autorisées (CORS) = comment le portail est servi par le routeur.
# Ajustez si votre dns-name/IP hotspot diffère (séparées par des virgules).
CORS_ORIGINS=http://lambda.connect,http://172.17.10.1
# Nombre de proxys de confiance devant l'app (Render = 1).
TRUST_PROXY=1
# Où /return renvoie le client après le paiement (page du portail captif).
PORTAL_RETURN_URL=http://lambda.connect/prix.html

# ---- Comportement ----
ORDER_EXPIRY_MINUTES=15
RECONCILE_INTERVAL_MS=120000
VERIFY_THROTTLE_MS=4000
